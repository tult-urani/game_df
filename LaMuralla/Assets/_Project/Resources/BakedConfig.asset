      \"_laneShapeNote\": \"V\xF2ng 27: d\u1EF1ng l\u1EA1i theo ki\u1EC3u M\u1ED8T
      TH\xC2N CHUNG, HAI L\u1ED0I RA. \u0110o\u1EA1n chung d\xE0i 20.1u (58% chi\u1EC1u
      d\xE0i m\u1ED9t tuy\u1EBFn) \u2014 m\u1ECDi \xF4 c\u1EA1nh th\xE2n canh \u0111\u01B0\u1EE3c
      C\u1EA2 HAI tuy\u1EBFn, n\xEAn ti\u1EC1n kh\u1EDFi \u0111\u1EA7u v\u1EC1 m\u1EE9c
      map m\u1ED9t tuy\u1EBFn. \u0110o\u1EA1n ch\u1EBB cu\u1ED1i v\u1EABn b\u1EAFt
      chia l\u1EF1c. L\xFD do: docs/09 \xA78 \u2014 gi\xE1 c\u1EE7a map \u0111a tuy\u1EBFn
      n\u1EB1m \u1EDF \xF4 b\u1ECB kho\xE1 c\u1EE9ng v\xE0o m\u1ED9t tuy\u1EBFn,
      kh\xF4ng n\u1EB1m \u1EDF s\u1ED1 tuy\u1EBFn.\",\n  \"farSlots\": [],\n  \"maxGapFraction\":
      0.22,\n  \"_gapNote\": \"Khai 0.190 thay v\xEC l\u1EA5y s\xE0n 0.185. S\u1ED1
      \u0110O \u0110\u01AF\u1EE2C: khe h\u1EDF l\u1EDBn nh\u1EA5t l\xE0 5.86 units
      tr\xEAn tuy\u1EBFn `L2`, c\xF2n m00 \u2014 map \u0111\xE3 c\xE2n xong \u2014
      \u0111\u01B0\u1EE3c ch\u1EA5p nh\u1EADn \u1EDF 6.16 units. Lu\u1EADt g\u1ED1c
      t\xEDnh theo T\u1EC8 L\u1EC6 chi\u1EC1u d\xE0i n\xEAn n\xF3 ph\u1EA1t map tuy\u1EBFn
      ng\u1EAFn; t\xEDnh b\u1EB1ng qu\xE3ng \u0111\u01B0\u1EDDng th\u1EADt th\xEC
      map n\xE0y k\xEDn h\u01A1n m00.\",\n  \"_slotAddNote\": \"V\xF2ng 27: th\xEAm
      12 \xF4. \u0110o \u0111\u01B0\u1EE3c c\xE1c tuy\u1EBFn bi\xEAn ch\u1EC9 \u0111\u1EA1t
      100% m\u1EE9c \u03A3chord c\u1EE7a m00 \u2014 m\u1ED9t con qu\xE1i \u0111i
      tuy\u1EBFn \u0111\xF3 \u0103n ch\u01B0a t\u1EDBi n\u1EEDa l\u01B0\u1EE3ng s\xE1t
      th\u01B0\u01A1ng so v\u1EDBi map g\u1ED1c. B\xF9 b\u1EB1ng ti\u1EC1n kh\u1EDFi
      \u0111\u1EA7u th\xEC ph\u1EA3i t\u1EDBi 4 300 (g\u1EA5p 6 l\u1EA7n thi\u1EBFt
      k\u1EBF) v\xE0 v\u1EABn ph\u1EA3i c\u1EAFt g\u1EA7n n\u1EEDa s\u1ED1 qu\xE2n.
      Thi\u1EBFu l\xE0 thi\u1EBFu \xD4, kh\xF4ng ph\u1EA3i thi\u1EBFu ti\u1EC1n.
      Xem docs/09 \xA78.7.\",\n  \"_waveNote\": \"V\xF2ng 27: d\u1EF1ng l\u1EA1i
      theo d\xE1ng wave c\u1EE7a m00 (map \u0111\xE3 c\xE2n xong), chia \u0111\xF4i
      hai tuy\u1EBFn. B\u1EA3ng c\u0169 vi\u1EBFt cho ba tuy\u1EBFn / lu\xE2n phi\xEAn
      n\xEAn kh\xF4ng c\xF2n d\xF9ng \u0111\u01B0\u1EE3c sau khi \u0111\u1ED5i sang
      ki\u1EC3u m\u1ED9t th\xE2n chung hai l\u1ED1i ra.\",\n  \"goalkeeperMinLeadUnits\":
      1.0,\n  \"goalkeeperMinCoverageUnits\": 2.0,\n  \"_goalkeeperPlacementNote\":
      \"\xD4 Dibu ph\u1EA3i canh m\u1ED9t \u0111o\u1EA1n \u0111\u01B0\u1EDDng d\xE0i
      \xEDt nh\u1EA5t goalkeeperMinCoverageUnits v\xE0 to\xE0n b\u1ED9 \u0111o\u1EA1n
      \u0111\xF3 ph\u1EA3i n\u1EB1m tr\u01B0\u1EDBc l\u1ED1i ra \xEDt nh\u1EA5t goalkeeperMinLeadUnits.
      Hai ng\u01B0\u1EE1ng \u0111\u01B0\u1EE3c tools/path_check.py --check thi h\xE0nh;
      kh\xF4ng \u0111\u01B0\u1EE3c k\xE9o \xF4 v\u1EC1 s\xE1t c\u1EA7u m\xF4n ch\u1EC9
      v\xEC nh\xECn gi\u1ED1ng v\u1ECB tr\xED th\u1EE7 m\xF4n.\"\n}\n"

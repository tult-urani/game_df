      m\u1EDBi cho qua; kh\xF4ng khai th\xEC n\xF3 b\xE1o \xF4 ch\u1EBFt, v\xE0 \u0111\xFAng
      l\xE0 n\xEAn b\xE1o: \xF4 ngo\xE0i t\u1EA7m m\xE0 kh\xF4ng ai bi\u1EBFt l\xE0
      ti\u1EC1n ng\u01B0\u1EDDi ch\u01A1i n\xE9m \u0111i.\",\n  \"_balanceNote\":
      \"Hai tuy\u1EBFn \u0111\u1ED1i x\u1EE9ng bu\u1ED9c chia ti\u1EC1n; b\u1ED1n
      wave \u0111\u1EA7u lu\xE2n phi\xEAn \u0111\u1EC3 ng\u01B0\u1EDDi ch\u01A1i
      k\u1ECBp \u0111\u1ECDc tuy\u1EBFn, t\u1EEB wave 5 \u0111\xE1nh \u0111\u1ED3ng
      th\u1EDDi. Wave 20 t\u0103ng Tambor ph\xEDa \u0110\xF4ng \u0111\u1EC3 kh\xF3a
      m\u1EE9c kh\xF3 m\u1EE5c ti\xEAu.\",\n  \"_laneShapeNote\": \"Hai tuy\u1EBFn
      ziczac t\xE1ch bi\u1EC7t quanh tr\u1EE5c gi\u1EEFa, ch\u1EC9 h\u1ED9i t\u1EE5
      s\xE1t c\u1EA7u m\xF4n. \xD4 bi\xEAn chuy\xEAn canh m\u1ED9t tuy\u1EBFn; hai
      \xF4 trung t\xE2m c\u1EA7n n\xE2ng t\u1EA7m m\u1EDBi h\u1ED7 tr\u1EE3 hi\u1EC7u
      qu\u1EA3 c\u1EA3 hai.\",\n  \"maxGapFraction\": 0.25,\n  \"_gapNote\": \"Khai
      0.170 thay v\xEC l\u1EA5y s\xE0n 0.150. S\u1ED1 \u0110O \u0110\u01AF\u1EE2C:
      khe h\u1EDF l\u1EDBn nh\u1EA5t l\xE0 4.90 units tr\xEAn tuy\u1EBFn `W`, c\xF2n
      m00 \u2014 map \u0111\xE3 c\xE2n xong \u2014 \u0111\u01B0\u1EE3c ch\u1EA5p
      nh\u1EADn \u1EDF 6.16 units. Lu\u1EADt g\u1ED1c t\xEDnh theo T\u1EC8 L\u1EC6
      chi\u1EC1u d\xE0i n\xEAn n\xF3 ph\u1EA1t map tuy\u1EBFn ng\u1EAFn; t\xEDnh
      b\u1EB1ng qu\xE3ng \u0111\u01B0\u1EDDng th\u1EADt th\xEC map n\xE0y k\xEDn
      h\u01A1n m00.\",\n  \"_slotAddNote\": \"14 \xF4 s\xE2n: 10 \xF4 chuy\xEAn tuy\u1EBFn,
      2 \xF4 trung t\xE2m t\u1EA7m xa v\xE0 2 \xF4 bi\xEAn b\u1ED5 sung \u0111\u1EC3
      tr\xE1nh \u0111i\u1EC3m m\xF9 \u1EDF n\u1EEDa sau \u0111\u01B0\u1EDDng ch\u1EA1y.\",\n 
      \"_waveNote\": \"W1\u20134 lu\xE2n phi\xEAn T\xE2y/\u0110\xF4ng; W5\u201320
      m\u1EDF \u0111\u1ED3ng th\u1EDDi. C\xE1c wave cu\u1ED1i t\u0103ng Tifoso/Tambor,
      boss W20 \u0111i tuy\u1EBFn \u0110\xF4ng.\",\n  \"_goalkeeperSplitNote\": \"m08
      c\xF3 HAI \xF4 th\u1EE7 m\xF4n ch\u1EE9 kh\xF4ng ph\u1EA3i m\u1ED9t. \u0110o
      b\u1EB1ng tools/reposition_slots.py: hai tuy\u1EBFn W/E c\xE1ch nhau 2.10u
      \u1EDF 2u tr\u01B0\u1EDBc l\u1ED1i ra v\xE0 5.02u \u1EDF 5u tr\u01B0\u1EDBc
      l\u1ED1i ra \u2014 kh\xF4ng t\u1ED3n t\u1EA1i \u0111i\u1EC3m n\xE0o t\u1EA7m
      Dibu 1.4 ph\u1EE7 \u0111\u01B0\u1EE3c c\u1EA3 hai. M\u1ED9t \xF4 th\u1EE7 m\xF4n
      \u1EDF \u0111\xE2y ngh\u0129a l\xE0 m\u1ED9t trong hai c\u1EEDa KH\xD4NG BAO
      GI\u1EDC \u0111\u01B0\u1EE3c c\u1EA3n. m04/m09/m10 c\xF9ng h\xECnh h\u1ECDc
      tuy\u1EBFn t\xE1ch r\u1EDDi v\xE0 \u0111\u1EC1u \u0111\xE3 d\xF9ng hai \xF4
      t\u1EEB tr\u01B0\u1EDBc.\",\n  \"goalkeeperMinLeadUnits\": 1.0,\n  \"goalkeeperMinCoverageUnits\":
      2.0,\n  \"_goalkeeperPlacementNote\": \"\xD4 Dibu ph\u1EA3i canh m\u1ED9t \u0111o\u1EA1n
      \u0111\u01B0\u1EDDng d\xE0i \xEDt nh\u1EA5t goalkeeperMinCoverageUnits v\xE0
      to\xE0n b\u1ED9 \u0111o\u1EA1n \u0111\xF3 ph\u1EA3i n\u1EB1m tr\u01B0\u1EDBc
      l\u1ED1i ra \xEDt nh\u1EA5t goalkeeperMinLeadUnits. Hai ng\u01B0\u1EE1ng \u0111\u01B0\u1EE3c
      tools/path_check.py --check thi h\xE0nh; kh\xF4ng \u0111\u01B0\u1EE3c k\xE9o
      \xF4 v\u1EC1 s\xE1t c\u1EA7u m\xF4n ch\u1EC9 v\xEC nh\xECn gi\u1ED1ng v\u1ECB
      tr\xED th\u1EE7 m\xF4n.\"\n}\n"

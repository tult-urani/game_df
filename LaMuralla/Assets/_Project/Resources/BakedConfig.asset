      1.075\n  },\n  \"_hpScalingNote\": \"B\xF9 cho \u0111\u1ED9 ph\u1EE7: map c\xF3
      \xF4 canh nhi\u1EC1u tuy\u1EBFn / \u0111\u01B0\u1EDDng t\u1EF1 \xE1p s\xE1t
      th\xEC t\u01B0\u1EDBng m\u1EA1nh l\xEAn, kh\xF4ng b\xF9 th\xEC map c\xE0ng
      'th\xFA v\u1ECB' c\xE0ng D\u1EC4. Gi\xE1 tr\u1ECB n\xE0y l\xE0 \u0110\xCDCH
      C\u1EA6N \u0110O b\u1EB1ng qu\xE9t engine.\",\n  \"bossOverrides\": {\n   
      \"o_capitao\": {\n      \"slowResistPercent\": 80,\n      \"appearances\":
      [\n        {\n          \"wave\": 5,\n          \"hp\": 750,\n          \"bounty\":
      40\n        },\n        {\n          \"wave\": 10,\n          \"hp\": 1900,\n         
      \"bounty\": 80\n        },\n        {\n          \"wave\": 15,\n          \"hp\":
      2200,\n          \"bounty\": 110\n        },\n        {\n          \"wave\":
      20,\n          \"hp\": 3000,\n          \"bounty\": 180\n        }\n      ]\n   
      }\n  },\n  \"_bossNote\": \"HP m\u1ED7i boss t\u0103ng qua W5/W10/W15/W20;
      W15/W20 c\xF3 hai boss n\xEAn ph\u1EA3i ch\u1EA5m theo t\u1ED5ng HP encounter.\",\n 
      \"_f06Note\": \"\U0001F535 f06 d\u1EDDi (-1.92,-4.91) \u2192 (-2.10,-5.30):
      khe h\u1EDF tuy\u1EBFn `corta` 20.1% \u2192 17.9%. S\xE0n to\xE1n h\u1ECDc
      c\u1EE7a b\u1ED1 c\u1EE5c 2 tuy\u1EBFn 12 \xF4 l\xE0 20%, n\xEAn 20.1% l\xE0
      V\u1EEAA TR\xC0N ch\u1EE9 kh\xF4ng ph\u1EA3i b\u1ED1 c\u1EE5c h\u1ECFng \u2014
      nh\u01B0ng d\u1EDDi m\u1ED9t \xF4 r\u1EBB h\u01A1n n\u1EDBi lu\u1EADt, v\xE0
      n\u1EDBi lu\u1EADt th\xEC l\u1EA7n sau kh\xF4ng ai bi\u1EBFt v\xEC sao n\xF3
      \u0111\u01B0\u1EE3c n\u1EDBi.\",\n  \"_balanceNote\": \"V\xF2ng 27b: ti\u1EC1n
      2100\u2192800, gi\u1EEF nguy\xEAn s\u1ED1 qu\xE2n.\",\n  \"_laneShapeNote\":
      \"V\xF2ng 27: d\u1EF1ng l\u1EA1i theo ki\u1EC3u M\u1ED8T TH\xC2N CHUNG, HAI
      L\u1ED0I RA. \u0110o\u1EA1n chung d\xE0i 23.7u (65% chi\u1EC1u d\xE0i m\u1ED9t
      tuy\u1EBFn) \u2014 m\u1ECDi \xF4 c\u1EA1nh th\xE2n canh \u0111\u01B0\u1EE3c
      C\u1EA2 HAI tuy\u1EBFn, n\xEAn ti\u1EC1n kh\u1EDFi \u0111\u1EA7u v\u1EC1 m\u1EE9c
      map m\u1ED9t tuy\u1EBFn. \u0110o\u1EA1n ch\u1EBB cu\u1ED1i v\u1EABn b\u1EAFt
      chia l\u1EF1c. L\xFD do: docs/09 \xA78 \u2014 gi\xE1 c\u1EE7a map \u0111a tuy\u1EBFn
      n\u1EB1m \u1EDF \xF4 b\u1ECB kho\xE1 c\u1EE9ng v\xE0o m\u1ED9t tuy\u1EBFn,
      kh\xF4ng n\u1EB1m \u1EDF s\u1ED1 tuy\u1EBFn.\",\n  \"farSlots\": [],\n  \"_slotAddNote\":
      \"V\xF2ng 27: th\xEAm 13 \xF4. \u0110o \u0111\u01B0\u1EE3c c\xE1c tuy\u1EBFn
      bi\xEAn ch\u1EC9 \u0111\u1EA1t 126% m\u1EE9c \u03A3chord c\u1EE7a m00 \u2014
      m\u1ED9t con qu\xE1i \u0111i tuy\u1EBFn \u0111\xF3 \u0103n ch\u01B0a t\u1EDBi
      n\u1EEDa l\u01B0\u1EE3ng s\xE1t th\u01B0\u01A1ng so v\u1EDBi map g\u1ED1c.
      B\xF9 b\u1EB1ng ti\u1EC1n kh\u1EDFi \u0111\u1EA7u th\xEC ph\u1EA3i t\u1EDBi
      4 300 (g\u1EA5p 6 l\u1EA7n thi\u1EBFt k\u1EBF) v\xE0 v\u1EABn ph\u1EA3i c\u1EAFt
      g\u1EA7n n\u1EEDa s\u1ED1 qu\xE2n. Thi\u1EBFu l\xE0 thi\u1EBFu \xD4, kh\xF4ng
      ph\u1EA3i thi\u1EBFu ti\u1EC1n. Xem docs/09 \xA78.7.\",\n  \"_waveNote\": \"V\xF2ng
      27: d\u1EF1ng l\u1EA1i theo d\xE1ng wave c\u1EE7a m00 (map \u0111\xE3 c\xE2n
      xong), chia \u0111\xF4i hai tuy\u1EBFn. B\u1EA3ng c\u0169 vi\u1EBFt cho ba
      tuy\u1EBFn / lu\xE2n phi\xEAn n\xEAn kh\xF4ng c\xF2n d\xF9ng \u0111\u01B0\u1EE3c
      sau khi \u0111\u1ED5i sang ki\u1EC3u m\u1ED9t th\xE2n chung hai l\u1ED1i ra.\",\n 
      \"maxGapFraction\": 0.2,\n  \"goalkeeperMinLeadUnits\": 1.0,\n  \"goalkeeperMinCoverageUnits\":
      2.0,\n  \"_goalkeeperPlacementNote\": \"\xD4 Dibu ph\u1EA3i canh m\u1ED9t \u0111o\u1EA1n
      \u0111\u01B0\u1EDDng d\xE0i \xEDt nh\u1EA5t goalkeeperMinCoverageUnits v\xE0
      to\xE0n b\u1ED9 \u0111o\u1EA1n \u0111\xF3 ph\u1EA3i n\u1EB1m tr\u01B0\u1EDBc
      l\u1ED1i ra \xEDt nh\u1EA5t goalkeeperMinLeadUnits. Hai ng\u01B0\u1EE1ng \u0111\u01B0\u1EE3c
      tools/path_check.py --check thi h\xE0nh; kh\xF4ng \u0111\u01B0\u1EE3c k\xE9o
      \xF4 v\u1EC1 s\xE1t c\u1EA7u m\xF4n ch\u1EC9 v\xEC nh\xECn gi\u1ED1ng v\u1ECB
      tr\xED th\u1EE7 m\xF4n.\"\n}\n"

  m_Name: BakedConfig
  m_EditorClassIdentifier: LaMuralla.Unity::LaMuralla.Unity.BakedConfig
  towersJson: "{\n  \"_comment\": \"NGU\u1ED2N CH\xC2N L\xDD S\u1ED0 LI\u1EC6U T\u01AF\u1EDANG.
    Docs 02/04 sinh b\u1EA3ng t\u1EEB file n\xE0y qua tools/gen-docs.py. \u0110\u1EEBng
    g\xF5 tay s\u1ED1 v\xE0o docs.\",\n  \"_units\": \"range + chord t\xEDnh b\u1EB1ng
    \u0111\u01A1n v\u1ECB s\xE2n = 1 Unity world unit. Xem docs/05 \xA74.1.\",\n 
    \"_upgradeRules\": {\n    \"damageMultiplierByLevel\": [\n      1.0,\n      1.6,\n     
    2.5\n    ],\n    \"costMultiplierByLevel\": [\n      1.0,\n      0.8,\n     
    1.6\n    ],\n    \"rangeIncrementPerLevel\": 0.2,\n    \"_rangeIncrementNote\":
    \"0.2, KH\xD4NG ph\u1EA3i 0.5. S\u1ED1 0.5 n\u1EB1m \u0111\xE2y t\u1EEB tr\u01B0\u1EDBc
    l\u1EA7n thu t\u1EA7m \xD70.36 \u1EDF v\xF2ng 5 v\xE0 kh\xF4ng ai s\u1EEDa \u2014
    m\u1ECDi t\u01B0\u1EDBng th\u1EADt \u0111\u1EC1u +0.2. Lu\u1EADt 17 gi\u1EDD
    \u0111\u1ED1i chi\u1EBFu kh\u1ED1i n\xE0y v\u1EDBi `levels`, n\xEAn n\xF3 kh\xF4ng
    th\u1EC3 l\u1EC7ch \xE2m th\u1EA7m n\u1EEFa.\",\n    \"attackRateNeverChanges\":
    true,\n    \"abilitiesAreCumulative\": false,\n    \"_abilitiesNote\": \"\U0001F534
    B-01 (user ch\u1ED1t 2026-07-17): t\u01B0\u1EDBng c\u1EA5p N ch\u1EA1y \u0110\xDANG
    M\u1ED8T k\u1EF9 n\u0103ng \u2014 c\xE1i c\xF3 `unlockLevel == N`. K\u1EF9 n\u0103ng
    c\u1EA5p th\u1EA5p KH\xD4NG ch\u1EA1y n\u1EEFa. N\xE2ng c\u1EA5p l\xE0 \u0110\xC1NH
    \u0110\u1ED4I, kh\xF4ng ph\u1EA3i c\u1ED9ng d\u1ED3n: Batigol Lv1 xuy\xEAn h\xE0ng
    (ch\u1ED1ng \u0111\xE1m \u0111\xF4ng), Lv3 nuke \u0111\u01A1n m\u1EE5c ti\xEAu
    (ch\u1ED1ng boss) \u2014 Lv3 \u0111\xE1nh \u0111\xE1m \u0111\xF4ng T\u1EC6 H\u01A0N
    Lv1, v\xE0 \u0111\xF3 l\xE0 \xFD \u0111\u1ED3. Ng\u01B0\u1EDDi ch\u01A1i c\xF3
    th\u1EC3 c\u1ED1 t\xECnh kh\xF4ng n\xE2ng.\",\n    \"_dibuException\": \"Dibu
    l\xE0 NGO\u1EA0I L\u1EC6 C\xD3 T\xCAN c\u1EE7a B-01 \u2014 xem `_b01Exception`
    trong kh\u1ED1i t\u01B0\u1EDBng \u0111\xF3.\"\n  },\n  \"towers\": [\n    {\n     
    \"id\": \"la_pulga\",\n      \"displayName\": \"La Pulga\",\n      \"tier\":
    \"S\",\n      \"role\": \"single_target_dps\",\n      \"slotType\": \"field\",\n     
    \"isPlayer\": true,\n      \"projectile\": \"ball_normal\",\n      \"levels\":
    [\n        {\n          \"level\": 1,\n          \"cost\": 300,\n          \"damage\":
    45,\n          \"attackRate\": 1.2,\n          \"range\": 1.4\n        },\n       
    {\n          \"level\": 2,\n          \"cost\": 240,\n          \"damage\": 90,\n         
    \"attackRate\": 1.2,\n          \"range\": 1.6\n        },\n        {\n         
    \"level\": 3,\n          \"cost\": 480,\n          \"damage\": 170,\n         
    \"attackRate\": 1.2,\n          \"range\": 1.8\n        }\n      ],\n      \"abilities\":
    [\n        {\n          \"id\": \"solo_run\",\n          \"unlockLevel\": 1,\n         
    \"trigger\": \"cooldown\",\n          \"cooldownSec\": 12.0,\n          \"params\":
    {\n            \"targetSelector\": \"highest_absolute_hp\",\n            \"damageMultiplier\":
    2.0,\n            \"durationSec\": 4.0\n          },\n          \"_summary\":
    \"\xD72 dame l\xEAn m\u1EE5c ti\xEAu m\xE1u cao nh\u1EA5t, 4s / m\u1ED7i 12s\"\n       
    },\n        {\n          \"id\": \"nhan_quan\",\n          \"unlockLevel\": 2,\n         
    \"trigger\": \"passive\",\n          \"params\": {\n            \"bonusDamagePercentVsSlowed\":
    25,\n            \"neverMissSlowed\": true,\n            \"_neverMissSlowedIsDeadText\":
    \"`neverMissSlowed: true` KH\xD4NG L\xC0M G\xCC, v\xE0 kh\xF4ng th\u1EC3 l\xE0m
    g\xEC. Trong game n\xE0y kh\xF4ng c\xF3 c\u01A1 ch\u1EBF TR\u01AF\u1EE2T n\xE0o
    \u0111\u1EC3 m\xE0 'kh\xF4ng tr\u01B0\u1EE3t': docs/03 \xA76 n\xF3i qu\xE2n 'kh\xF4ng
    n\xE9 t\u01B0\u1EDBng', docs/05 \xA74.3 n\xF3i \u0111\u1EA1n B\xC1M m\u1EE5c
    ti\xEAu (homing) \u2014 \u0111\u1EA1n homing kh\xF4ng tr\u01B0\u1EE3t k\u1EC3
    c\u1EA3 m\u1EE5c ti\xEAu kh\xF4ng b\u1ECB ch\u1EADm. C\xE1ch duy nh\u1EA5t m\u1ED9t
    ph\xE1t b\u1EAFn b\u1ECB ph\xED l\xE0 m\u1EE5c ti\xEAu CH\u1EBET gi\u1EEFa l\xFAc
    \u0111\u1EA1n bay (docs/05 \xA74.3 d\xF2ng 232), m\xE0 \u0111i\u1EC1u \u0111\xF3
    kh\xF4ng li\xEAn quan g\xEC t\u1EDBi b\u1ECB ch\u1EADm hay kh\xF4ng. \u0110\xE2y
    l\xE0 t\xE0n d\u01B0 c\u1EE7a m\u1ED9t thi\u1EBFt k\u1EBF c\u0169 n\u01A1i \u0111\u1EA1n
    c\xF3 th\u1EC3 b\u1EAFn h\u1EE5t. GI\u1EEE L\u1EA0I tr\u01B0\u1EDDng n\xE0y \u0111\u1EC3
    docs/02 v\xE0 config c\xF2n kh\u1EDBp nhau, nh\u01B0ng AbilityEngine c\u1ED1
    t\xECnh KH\xD4NG \u0111\u1ECDc n\xF3. N\u1EBFu sau n\xE0y th\xEAm c\u01A1 ch\u1EBF
    tr\u01B0\u1EE3t th\u1EADt th\xEC \u0111\xE2y l\xE0 ch\u1ED7 n\u1ED1i. C\xE2n
    b\u1EB1ng kh\xF4ng \u0111\u1ED5i: balance_sim ch\u01B0a t\u1EEBng m\xF4 h\xECnh
    ho\xE1 vi\u1EC7c tr\u01B0\u1EE3t.\"\n          },\n          \"_summary\": \"+25%
    dame l\xEAn m\u1EE5c ti\xEAu **\u0111ang b\u1ECB ch\u1EADm**; kh\xF4ng tr\u01B0\u1EE3t\"\n       
    },\n        {\n          \"id\": \"so_10\",\n          \"unlockLevel\": 3,\n         
    \"trigger\": \"every_nth_attack\",\n          \"params\": {\n            \"n\":
    4,\n            \"pierceCount\": 2\n          },\n          \"_summary\": \"M\u1ED7i
    \u0111\xF2n th\u1EE9 4 xuy\xEAn qua 2 qu\xE2n ph\xEDa sau\"\n        }\n     
    ],\n      \"_lv3ValueNote\": \"\U0001F535 V\xD2NG 22 \u2014 Lv3 dame 141 \u2192
    170. L\xFD do KH\xD4NG ph\u1EA3i 'cho m\u1EA1nh h\u01A1n' m\xE0 l\xE0 s\u1EEDa
    m\u1ED9t NGH\u1ECACH L\xDD GI\xC1 TR\u1ECA: Lv3 l\xE0 kho\u1EA3n mua \u0110\u1EAET
    NH\u1EA4T game (480 Peso, lu\u1EF9 k\u1EBF 1020) nh\u01B0ng l\xE0 c\u1EA5p DUY
    NH\u1EA4T t\u1EE5t h\u1EA1ng \u1EDF C\u1EA2 hai b\u1EA3ng hi\u1EC7u su\u1EA5t/Peso.
    G\u1ED1c n\u1EB1m \u1EDF lu\u1EADt B-01 'c\u1EA5p N ch\u1EA1y \u0110\xDANG M\u1ED8T
    k\u1EF9 n\u0103ng': l\xEAn Lv3 l\xE0 M\u1EA4T `solo_run` (\xD72 l\xEAn m\u1EE5c
    ti\xEAu m\xE1u cao nh\u1EA5t = ch\xEDnh l\xE0 boss, uptime 33% \u21D2 \xD71.33)
    v\xE0 M\u1EA4T `nhan_quan` (+25%), \u0111\u1ED5i l\u1EA5y `so_10` (xuy\xEAn 2
    qu\xE2n PH\xCDA SAU). Nh\u01B0ng role c\u1EE7a t\u01B0\u1EDBng n\xE0y l\xE0 single_target_dps
    v\xE0 boss th\xEC \u0110I M\u1ED8T M\xCCNH \u2014 kh\xF4ng c\xF3 qu\xE2n ph\xEDa
    sau \u0111\u1EC3 xuy\xEAn, n\xEAn `so_10` nh\xE2n \xD71.00. \u0110o \u0111\u01B0\u1EE3c:
    DPS-vs-boso tr\xEAn m\u1ED7i Peso 0.240 (Lv1) \u2192 0.250 (Lv2) \u2192 0.166
    (Lv3) = S\u1EE4T 34% \u1EDF \u0111\xFAng vai tr\xF2 n\xF3 sinh ra \u0111\u1EC3
    l\xE0m. \u1EDE 170 th\xEC th\xE0nh 0.200 \u2014 v\u1EABn gi\u1EA3m d\u1EA7n (\u0111\xFAng
    chu\u1EA9n TD, v\xE0 tr\u1EA7n maxBuildCost d\u1EF1a v\xE0o vi\u1EC7c n\xF3 gi\u1EA3m
    d\u1EA7n) nh\u01B0ng h\u1EBFt s\u1EE5t v\u1EF1c. \u26A0\uFE0F CH\u01AFA gi\u1EA3i
    g\u1ED1c: `so_10` v\u1EABn l\xE0 k\u1EF9 n\u0103ng \u0111\xE1m-\u0111\xF4ng g\u1EAFn
    tr\xEAn t\u01B0\u1EDBng \u0111\u01A1n-m\u1EE5c-ti\xEAu. S\u1EEDa g\u1ED1c c\u1EA7n
    k\u1EF9 n\u0103ng Lv3 m\u1EDBi + code AbilityEngine, kh\xF4ng ph\u1EA3i m\u1ED9t
    con s\u1ED1.\"\n    },\n    {\n      \"id\": \"d10s\",\n      \"displayName\":
    \"D10S\",\n      \"tier\": \"S\",\n      \"role\": \"aoe_control\",\n      \"slotType\":
    \"field\",\n      \"isPlayer\": true,\n      \"projectile\": \"shockwave\",\n     
    \"levels\": [\n        {\n          \"level\": 1,\n          \"cost\": 240,\n         
    \"damage\": 30,\n          \"attackRate\": 0.8,\n          \"range\": 1.2,\n         
    \"splashRadius\": 1.2\n        },\n        {\n          \"level\": 2,\n         
    \"cost\": 192,\n          \"damage\": 48,\n          \"attackRate\": 0.8,\n         
    \"range\": 1.4,\n          \"splashRadius\": 1.7\n        },\n        {\n         
    \"level\": 3,\n          \"cost\": 384,\n          \"damage\": 75,\n         
    \"attackRate\": 0.8,\n          \"range\": 1.6,\n          \"splashRadius\":
    1.2,\n          \"_b01\": \"1.7 \u2192 1.2. Con s\u1ED1 1.7 = 1.2 c\u01A1 b\u1EA3n
    + 0.5 c\u1EE7a `cu_cham_thien_tai` (Lv2) \u0111\xE3 c\u1ED9ng s\u1EB5n v\xE0o
    level \u2014 t\u1EE9c n\xF3 m\xE3 ho\xE1 gi\u1EA3 \u0111\u1ECBnh t\xEDch lu\u1EF9.
    Theo B-01, Lv3 KH\xD4NG ch\u1EA1y `cu_cham_thien_tai` n\u1EEFa \u2192 lan quay
    v\u1EC1 1.2 c\u01A1 b\u1EA3n. Lv2 lan R\u1ED8NG H\u01A0N Lv3, v\xE0 \u0111\xF3
    l\xE0 \u0111\xE1nh \u0111\u1ED5i c\xF3 ch\u1EE7 \xFD.\"\n        }\n      ],\n     
    \"_b01Tradeoff\": \"D10S theo B-01 l\xE0 ba vai tr\xF2 kh\xE1c h\u1EB3n nhau,
    KH\xD4NG ph\u1EA3i n\u1EA5c thang: Lv1 = kh\u1ED1ng ch\u1EBF (ch\u1EADm 50%,
    lan 1.2) \xB7 Lv2 = s\xE1t th\u01B0\u01A1ng di\u1EC7n r\u1ED9ng th\xF4 (lan 1.7,
    KH\xD4NG ch\u1EADm) \xB7 Lv3 = h\u1ED7 tr\u1EE3 \u0111\u1ED9i (m\u1ECDi t\u01B0\u1EDBng
    +20% l\xEAn m\u1EE5c ti\xEAu b\u1ECB ch\u1EADm, nh\u01B0ng t\u1EF1 n\xF3 KH\xD4NG
    ch\u1EADm \u0111\u01B0\u1EE3c ai v\xE0 lan ch\u1EC9 1.2). H\u1EC7 qu\u1EA3: ch\u1EC9
    Lv1 c\xF2n kh\u1ED1ng ch\u1EBF. Lv3 v\xF4 d\u1EE5ng n\u1EBFu kh\xF4ng c\xF3 \xC1rbitro
    ho\u1EB7c m\u1ED9t D10S Lv1 kh\xE1c l\xE0m ch\u1EADm h\u1ED9.\",\n      \"abilities\":
    [\n        {\n          \"id\": \"ban_tay_cua_chua\",\n          \"unlockLevel\":
    1,\n          \"trigger\": \"cooldown\",\n          \"cooldownSec\": 15.0,\n         
    \"params\": {\n            \"slowPercent\": 50,\n            \"scope\": \"timed\",\n           
    \"durationSec\": 3.0,\n            \"area\": \"in_range\"\n          },\n         
    \"_summary\": \"Ch\u1EADm 50% trong t\u1EA7m, 3s / m\u1ED7i 15s\"\n        },\n       
    {\n          \"id\": \"cu_cham_thien_tai\",\n          \"unlockLevel\": 2,\n         
    \"trigger\": \"passive\",\n          \"params\": {\n            \"_removed_splashRadiusBonus\":
    \"\u0110\xC3 G\u1EE0 `splashRadiusBonus: 0.5`. N\xF3 l\xE0 M\xCCN H\u1EB8N GI\u1EDC:
    `levels[1].splashRadius` \u0111\xE3 l\xE0 1.7 = 1.2 + 0.5, t\u1EE9c bonus \u0110\xC3
    \u0111\u01B0\u1EE3c c\u1ED9ng s\u1EB5n. Code n\xE0o \u0111\u1ECDc c\u1EA3 hai
    ra 2.2 \u2014 kh\xF4ng crash, ch\u1EC9 l\xE0 D10S Lv2 m\u1EA1nh h\u01A1n thi\u1EBFt
    k\u1EBF 29% v\xE0 b\u1EA3ng c\xE2n b\u1EB1ng sai. `levels[].splashRadius` l\xE0
    NGU\u1ED2N CH\xC2N L\xDD DUY NH\u1EA4T c\u1EE7a b\xE1n k\xEDnh lan; k\u1EF9 n\u0103ng
    n\xE0y ch\u1EC9 c\xF2n l\xE0 c\xE1i T\xCAN gi\u1EA3i th\xEDch v\xEC sao Lv2 r\u1ED9ng
    h\u01A1n Lv1. Lu\u1EADt 19 c\u1EE7a validator ch\u1EB7n m\u1ECDi tham s\u1ED1
    k\u1EF9 n\u0103ng tr\xF9ng vai v\u1EDBi tr\u01B0\u1EDDng \u1EDF levels.\"\n         
    },\n          \"_summary\": \"B\xE1n k\xEDnh lan r\u1ED9ng h\u01A1n \u2014 1.2
    (Lv1) \u2192 1.7. Con s\u1ED1 n\u1EB1m \u1EDF `levels[1].splashRadius`.\",\n         
    \"_tradeoff\": \"\u0110\xE2y l\xE0 c\u1EA5p lan R\u1ED8NG NH\u1EA4T c\u1EE7a
    D10S. Lv3 t\u1EE5t v\u1EC1 1.2 \u0111\u1EC3 \u0111\u1ED5i l\u1EA5y buff \u0111\u1ED9i
    (+20% l\xEAn m\u1EE5c ti\xEAu b\u1ECB ch\u1EADm). \u0110\xF4ng qu\xE2n \u2192
    Lv2. C\xF3 \xC1rbitro l\xE0m ch\u1EADm \u2192 Lv3.\"\n        },\n        {\n         
    \"id\": \"ban_thang_the_ky\",\n          \"unlockLevel\": 3,\n          \"trigger\":
    \"passive\",\n          \"params\": {\n            \"allTowersBonusDamagePercentVsSlowed\":
    20,\n            \"_b01\": \"B\u1ECE `onlyWhileOwnSlowActive: true`. N\xF3 tr\u1ECF
    t\u1EDBi slow c\u1EE7a `ban_tay_cua_chua` (Lv1) \u2014 th\u1EE9 KH\xD4NG c\xF2n
    ch\u1EA1y \u1EDF Lv3 theo B-01, n\xEAn \u0111i\u1EC1u ki\u1EC7n s\u1EBD kh\xF4ng
    bao gi\u1EDD \u0111\xFAng v\xE0 k\u1EF9 n\u0103ng ch\u1EBFt. Cho D10S Lv3 t\u1EF1
    slow c\u0169ng kh\xF4ng \u0111\u01B0\u1EE3c: \u0111\xF3 l\xE0 l\xE9n t\xEDch
    lu\u1EF9 Lv1 qua c\u1EEDa sau. N\xEAn n\xF3 c\u1EA7n NG\u01AF\u1EDCI KH\xC1C
    l\xE0m ch\u1EADm.\",\n            \"requiresExternalSlowSource\": true\n         
    },\n          \"_summary\": \"M\u1ECDi t\u01B0\u1EDBng +20% dame l\xEAn m\u1EE5c
    ti\xEAu b\u1ECB ch\u1EADm \u2014 nh\u01B0ng D10S Lv3 KH\xD4NG t\u1EF1 l\xE0m
    ch\u1EADm \u0111\u01B0\u1EE3c n\u1EEFa\",\n          \"_tradeoff\": \"Lv1 t\u1EF1
    l\xE0m ch\u1EADm 50% v\xE0 s\u1ED1ng \u0111\u1ED9c l\u1EADp. Lv3 kh\xF4ng l\xE0m
    ch\u1EADm ai, ch\u1EC9 khu\u1EBFch \u0111\u1EA1i vi\u1EC7c ng\u01B0\u1EDDi kh\xE1c
    l\xE0m ch\u1EADm \u2192 m\u1ED9t m\xECnh th\xEC v\xF4 d\u1EE5ng, \u0111\u1EE9ng
    c\u1EA1nh \xC1rbitro th\xEC m\u1EA1nh. \u0110\xFAng tinh th\u1EA7n 'B\xE0n th\u1EAFng
    th\u1EBF k\u1EF7': b\xE0n th\u1EAFng c\u1EA7n c\u1EA3 \u0111\u1ED9i.\"\n       
    }\n      ]\n    },\n    {\n      \"id\": \"batigol\",\n      \"displayName\":
    \"El Cinco\",\n      \"tier\": \"A\",\n      \"role\": \"burst\",\n      \"slotType\":
    \"field\",\n      \"isPlayer\": true,\n      \"projectile\": null,\n      \"levels\":
    [\n        {\n          \"level\": 1,\n          \"cost\": 120,\n          \"damage\":
    20,\n          \"attackRate\": 0.6,\n          \"range\": 1.0,\n          \"splashRadius\":
    0.8\n        },\n        {\n          \"level\": 2,\n          \"cost\": 96,\n         
    \"damage\": 30,\n          \"attackRate\": 0.6,\n          \"range\": 1.2,\n         
    \"splashRadius\": 1.1\n        },\n        {\n          \"level\": 3,\n         
    \"cost\": 192,\n          \"damage\": 45,\n          \"attackRate\": 0.6,\n         
    \"range\": 1.4,\n          \"splashRadius\": 1.4\n        }\n      ],\n     
    \"abilities\": [\n        {\n          \"id\": \"cu_dam\",\n          \"unlockLevel\":
    1,\n          \"trigger\": \"passive\",\n          \"params\": {},\n         
    \"_summary\": \"**\u0110\u1EA5m** \u2192 n\u1ED5 nh\u1ECF t\u1EA1i v\u1ECB tr\xED
    qu\xE1i. M\u1ECDi qu\xE2n trong v\xF9ng n\u1ED5 b\u1ECB tr\u1EEB m\xE1u.\"\n       
    },\n        {\n          \"id\": \"cu_da\",\n          \"unlockLevel\": 2,\n         
    \"trigger\": \"passive\",\n          \"params\": {},\n          \"_summary\":
    \"**\u0110\xE1** \u2192 n\u1ED5 v\u1EEBa, dame m\u1EA1nh h\u01A1n. V\xF9ng n\u1ED5
    r\u1ED9ng h\u01A1n c\u1EA5p 1.\"\n        },\n        {\n          \"id\": \"cu_dap\",\n         
    \"unlockLevel\": 3,\n          \"trigger\": \"passive\",\n          \"params\":
    {},\n          \"_summary\": \"**H\xFAc cu\u1ED3ng n\u1ED9** \u2192 El Cinco
    b\xF9ng n\u1ED9, lao th\u1EB3ng v\xE0o qu\xE1i r\u1ED3i bi\u1EBFn m\u1EA5t trong
    v\u1EE5 n\u1ED5 l\u1EDBn. Dame v\xE0 v\xF9ng n\u1ED5 r\u1ED9ng nh\u1EA5t.\"\n       
    }\n      ],\n      \"_redesign\": \"\U0001F534 2026-07-22 \u2014 user ch\u1ED1t:
    \u0111\u1ED5i Batigol \u2192 'El Cinco' (Leandro Paredes, id gi\u1EEF nguy\xEAn).
    B\u1ECF sut_xuyen/ban_nang_sat_thu/cu_vo_le. M\u1ED7i c\u1EA5p m\u1ED9t \u0111\xF2n
    N\u1ED4 (\u0111\u1EA5m/\u0111\xE1/\u0111\u1EA1p) = AttackShape.Splash t\u1EA1i
    m\u1EE5c ti\xEAu, b\xE1n k\xEDnh = levels[].splashRadius 0.8/1.1/1.4, dame 60/96/150.
    N\u1ED5 m\u1ED7i \u0111\xF2n \u0111\xE1nh (nh\u1ECBp 0.6). GI\u1EEE dame (kh\xF4ng
    gi\u1EA3m b\xF9 AoE) \u2192 m\u1EA1nh h\u1EB3n l\xEAn, ch\u1EA5p nh\u1EADn l\u1EC7ch
    balance_sim, \u0111o l\u1EA1i \u1EDF M1. Aura = COSMETIC (\u0111\u1ECF/l\u1EEDa)
    \u1EDF view, kh\xF4ng c\u01A1 ch\u1EBF.\",\n      \"_rateNote\": \"\U0001F534

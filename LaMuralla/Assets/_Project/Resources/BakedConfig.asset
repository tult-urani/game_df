    ],\n  \"hpScaling\": {\n    \"_comment\": \"M\xC1U qu\xE1i = baseHp \xD7 \u0111\u01B0\u1EDDng
    cong tr\u01A1n \xD7 h\u1EC7 s\u1ED1 Hard c\u1EE7a m\u1ED1c g\u1EA7n nh\u1EA5t,
    l\xE0m tr\xF2n half_up. C\xE1c m\u1ED1c KH\xD4NG c\u1ED9ng d\u1ED3n.\",\n   
    \"formula\": \"hpMultiplier(wave) = base \xD7 pow(growthPerWave, wave - 1) \xD7
    latestMilestoneMultiplier(wave)\",\n    \"base\": 0.67,\n    \"growthPerWave\":
    1.09,\n    \"milestones\": [\n      { \"wave\": 5, \"multiplier\": 1.2 },\n     
    { \"wave\": 10, \"multiplier\": 1.4 },\n      { \"wave\": 15, \"multiplier\":
    1.7 },\n      { \"wave\": 20, \"multiplier\": 2.0 }\n    ],\n    \"_derivedBy\":
    \"tools/balance_sim.py --solve \u2014 qu\xE9t (base, growth), ch\u1ECDn b\u1ED9
    \u0111\u01B0a nhi\u1EC1u wave v\xE0o d\u1EA3i headroom nh\u1EA5t. KH\xD4NG ch\u1EC9nh
    tay: \u0111\u1ED5i s\u1ED1 \u1EDF \u0111\xE2y th\xEC ch\u1EA1y l\u1EA1i sim \u0111\u1EC3
    bi\u1EBFt wave n\xE0o v\u1EE1.\",\n    \"_whyNotPerAct\": \"H\u1EC7 s\u1ED1 b\u1EADc
    thang theo act t\u1EA1o V\xC1CH \u0110\u1EE8NG ngay sau ranh gi\u1EDBi act: \u0111o
    \u0111\u01B0\u1EE3c W8 headroom 1.00 v\xE0 W15 0.97 (thua) trong khi W14 cu\u1ED1i
    act 1.81 (qu\xE1 d\u1EC5) \u2014 bi\xEAn \u0111\u1ED9 1.81\xD7 trong c\xF9ng
    act. M\u1ED9t h\u1EC7 s\u1ED1 cho 7 wave kh\xF4ng th\u1EC3 v\u1EEBa c\u1EE9u
    \u0111\u1EA7u act v\u1EEBa gh\xEC cu\u1ED1i act. C\xF4ng th\u1EE9c tr\u01A1n:
    20/20 wave trong d\u1EA3i.\",\n    \"_monotone\": \"B\u1EAET BU\u1ED8C \u0111\u01A1n
    \u0111i\u1EC7u t\u0103ng \u2014 m\xE1u M\u1ED6I CON qu\xE1i kh\xF4ng bao gi\u1EDD
    \u0111\u01B0\u1EE3c gi\u1EA3m gi\u1EEFa hai wave. K\xEDch th\u01B0\u1EDBc wave
    th\xEC \u0110\u01AF\u1EE2C reset \u1EDF \u0111\u1EA7u act (W8, W15): \u0111\xF3
    l\xE0 nh\u1ECBp x\u1EA3 h\u01A1i c\u1ED1 \xFD sau cao tr\xE0o cu\u1ED1i act,
    kh\xF4ng ph\u1EA3i l\u1ED7i.\"\n  },\n  \"_actsNote\": \"Act gi\u1EDD CH\u1EC8
    \u0111i\u1EC1u khi\u1EC3n th\u01B0\u1EDFng (bountyMultiplier) v\xE0 \xFD \u0111\u1ED3
    k\u1EC3 chuy\u1EC7n. M\xE1u do hpScaling lo \u2014 xem _whyNotPerAct.\",\n  \"_spawnsNote\":
    \"\U0001F535 2026-08-21 \u2014 `spawns` \u0111\u1ED5i t\u1EEB OBJECT `{adepto:
    8}` sang M\u1EA2NG `[{enemy, count, lane}]`. Object kh\xF4ng nh\xE9t \u0111\u01B0\u1EE3c
    `lane` v\xE0 kh\xF4ng di\u1EC5n t\u1EA3 n\u1ED5i '8 adepto tuy\u1EBFn tr\xE1i
    + 6 adepto tuy\u1EBFn ph\u1EA3i' v\xEC kho\xE1 tr\xF9ng. D\u1EA1ng object KH\xD4NG
    c\xF2n \u0111\u01B0\u1EE3c ConfigMapper ch\u1EA5p nh\u1EADn \u2014 c\u1ED1 \xFD,
    nh\u1EADn c\u1EA3 hai th\xEC m\u1ECDi ch\u1ED7 \u0111\u1ECDc ph\u1EA3i r\u1EBD
    nh\xE1nh v\xE0 nh\xE1nh \u0111\xF3 l\xE0 n\u01A1i bug im l\u1EB7ng sinh ra. Xem
    docs/08 \xA72.2(b).\"\n}\n"
  economyJson: "{\n  \"_comment\": \"NGU\u1ED2N CH\xC2N L\xDD KINH T\u1EBE + THAM
    S\u1ED0 M\xD4 H\xCCNH C\xC2N B\u1EB0NG. Docs 04 sinh b\u1EA3ng t\u1EEB \u0111\xE2y.\",\n 
    \"startingCash\": 700,\n  \"goalHealth\": 20,\n  \"skipBonusPerSecond\": 3,\n 
    \"sellRefundRatio\": 0.6,\n  \"goalRepair\": {\n    \"baseCost\": 200,\n    \"costGrowth\":
    1.5,\n    \"healAmount\": 1\n  },\n  \"rewardedRecovery\": {\n    \"_comment\":
    \"Qu\u1EA3ng c\xE1o c\xF3 th\u01B0\u1EDFng duy nh\u1EA5t: h\u1ED3i m\xE1u ch\u1EC9
    trong gi\u1EDD ngh\u1EC9; continue ch\u1EC9 sau khi thua. Ch\u1EC9 callback reward
    m\u1EDBi \xE1p d\u1EE5ng.\",\n    \"healAmount\": 5,\n    \"healUsesPerMatch\":
    1,\n    \"continueHealth\": 5,\n    \"continueUsesPerMatch\": 1\n  },\n  \"slowCapPercent\":
    70,\n  \"_slowOrderOfOperations\": \"L\u1EA5y MAX c\xE1c ngu\u1ED3n slow \u2192
    cap 70% \u2192 R\u1ED2I m\u1EDBi nh\xE2n (1 - slowResistPercent/100). L\xE0m
    ng\u01B0\u1EE3c l\u1EA1i th\xEC kh\xE1ng ch\u1EADm th\xE0nh v\xF4 ngh\u0129a.
    Xem docs/01 \xA78 **FM-14**.\",\n  \"roundingMode\": \"half_up\",\n  \"_roundingNote\":
    \"B\u1EAET BU\u1ED8C. \xC1p cho M\u1ECCI ph\xE9p round(gi\xE1_tr\u1ECB_g\u1ED1c
    \xD7 h\u1EC7_s\u1ED1) \u2014 m\xE1u v\xE0 th\u01B0\u1EDFng. 'half_up' = 62.5
    \u2192 63 (l\xE0m tr\xF2n ra xa s\u1ED1 0).\",\n  \"_roundingWarning\": \"\u26A0\uFE0F
    Python round() V\xC0 C# Math.Round() m\u1EB7c \u0111\u1ECBnh d\xF9ng BANKER'S
    ROUNDING (l\xE0m tr\xF2n v\u1EC1 s\u1ED1 ch\u1EB5n): round(62.5) = 62, KH\xD4NG
    ph\u1EA3i 63. N\u1EBFu kh\xF4ng \xE9p half_up, tools/gen_docs.py v\xE0 Unity
    s\u1EBD ra hai k\u1EBFt qu\u1EA3 KH\xC1C NHAU tr\xEAn c\xF9ng m\u1ED9t config.
    \u0110\xE3 th\u1EF1c x\u1EA3y ra: Tambor th\u01B0\u1EDFng 25 \xD7 2.5 = 62.5
    \u2192 l\u1EC7ch 28 Peso tr\xEAn c\u1EA3 Act 3.\",\n  \"_roundingImpl\": {\n   
    \"python\": \"from decimal import Decimal, ROUND_HALF_UP; int(Decimal(x).quantize(0,
    ROUND_HALF_UP))\",\n    \"csharp\": \"Math.Round(x, MidpointRounding.AwayFromZero)\"\n 
